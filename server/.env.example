# ── Polaris backend + agent runtime ─────────────────────────────────────────
# Arc Testnet (verified values). ARC_RPC_URL accepts a comma-separated list of
# primary endpoints (e.g. a dedicated QuickNode/Alchemy key first) — the Arc
# public RPC (https://rpc.testnet.arc.network) is ALWAYS appended as an automatic
# failover, so a rate-limited/down primary degrades instead of breaking the API.
ARC_RPC_URL=https://rpc.testnet.arc.network

# Agent intelligence — Google Gemini via the official SDK (free tier). Powers
# both scoring (the trust core) and the agents' work generation. Key from
# https://aistudio.google.com/ (Get API key) — IMPORTANT: do not attach a
# billing account to that Google Cloud project, or the free tier disappears
# entirely and every call becomes billable. Gemini's Flash models have an
# internal "thinking" mode that shares the output-token budget, so
# LLM_MIN_TOKENS keeps short JSON answers from being truncated.
GEMINI_API_KEY=...
LLM_MODEL=gemini-flash-latest
LLM_MIN_TOKENS=4096
LLM_DEFAULT_TOKENS=8192

# Verifier signer — the key whose ADDRESS was passed to VerifierBridge at deploy
# (VERIFIER_SIGNER_ADDRESS). The backend signs verdicts with this; keep it secret.
VERIFIER_SIGNER_KEY=0x...

# Deployed contract addresses (from the Hardhat deploy script output)
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_CONTRACT_USDC_ESCROW=0x...
VITE_CONTRACT_AGENT_REGISTRY=0x...
VITE_CONTRACT_BID_ENGINE=0x...
VITE_CONTRACT_TASK_REGISTRY=0x...
VITE_CONTRACT_VERIFIER_BRIDGE=0x...

PORT=8787
DELIVERABLE_STORE=./deliverables.json
INDEX_LOOKBACK_BLOCKS=500000

# ── Autonomous swarm (node agent.js) ─────────────────────────────────────────
SWARM_POLL_MS=12000
# One funded Arc wallet per agent. markup<1 undercuts the budget (lower bid wins).
AGENTS_JSON=[{"name":"Atlas-Research","key":"0x...","capabilities":["research","analysis","summarization"],"stake":5,"markup":0.85},{"name":"Scribe-Writer","key":"0x...","capabilities":["writing","translation"],"stake":5,"markup":0.9}]

# ── x402 / Gateway nanopayments (Circle) ─────────────────────────────────────
X402_FACILITATOR=https://gateway-api-testnet.circle.com
X402_NETWORK=eip155:5042002
X402_CHAIN=arcTestnet
X402_SELLER=                 # defaults to the verifier signer address if set
X402_PAY_FOR_ORACLE=0        # set 1 to have agents pay $0.01 for the oracle sub-service
X402_ORACLE_URL=http://localhost:8787/api/oracle/price

# Agent-to-agent delegation (item 1) — a busy agent sub-contracts new wins to a
# peer via submitDirectTask, funded from its wallet, keeping the margin.
# OFF by default (0). Set e.g. 1 to delegate once an agent has 1 task in flight.
DELEGATE_THRESHOLD=0
DELEGATE_MARGIN=0.8

# Circle user-controlled wallets (PIN/email) — human "extra connect" option.
# Entity secret + API key are SERVER-ONLY (never exposed to the browser).
# From console.circle.com → Programmable Wallets → User-Controlled.
CIRCLE_UC_API_KEY=
CIRCLE_UC_ENTITY_SECRET=
CIRCLE_UC_APP_ID=
CIRCLE_UC_BLOCKCHAIN=ARC-TESTNET
CIRCLE_UC_ACCOUNT_TYPE=SCA

# ── Multi-chain: which networks this runtime serves ──────────────────────────
# Comma-separated. Defaults to arc-testnet alone. A network whose contracts
# aren't deployed is skipped with a log line, never served from another chain.
SWARM_NETWORKS=arc-testnet

# BOT Chain (testnet 968 "Bohr" / mainnet 677). Chain ids verified via eth_chainId.
# Settles in NATIVE BOT (18 decimals): value moves as msg.value, so there is no
# approve step and no escrow token. Stake and gas are the same coin here.
BOT_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
# Contract addresses come from deployments/<network>/contracts.json (written by
# contracts/scripts/deploy-network.cjs), so these are only needed to override:
# BOT_CONTRACT_TASK_REGISTRY_BOTCHAIN_TESTNET=0x...
# BOT_USDT_BOTCHAIN_TESTNET=0x...        # e.g. a TestUSDT deployment
# Optional per-network verdict signer (recommended on mainnet — don't reuse Arc's):
# BOT_VERIFIER_SIGNER_KEY_BOTCHAIN_MAINNET=0x...

# BOT agents are raw-key wallets (Circle has no BOT Chain support). Stake and gas
# are the same coin, so the swarm reserves SWARM_GAS_RESERVE above the stake before
# registering; otherwise an agent stakes its last BOT and can never pay to submit.
# Add "smartAccount": true to run an agent through an ERC-4337 account instead: its
# registry entry, bids and payouts then belong to the ACCOUNT, and its gas comes from
# that account's EntryPoint deposit rather than the owner key's balance.
# AGENTS_JSON_BOTCHAIN_TESTNET=[{"name":"Bohr-Research","key":"0x...","capabilities":["research"]},{"name":"Bohr-Writer","key":"0x...","capabilities":["writing"],"smartAccount":true}]
# SWARM_GAS_RESERVE=0.05
# SWARM_SMART_ACCOUNTS=1          # every agent on this network uses a 4337 account
# SWARM_ACCOUNT_DEPOSIT=0.02      # EntryPoint prefund topped up per account

# ── Access control ───────────────────────────────────────────────────────────
# /api/verify spends model credits and gas, so it is NOT open. The runtime's own
# processes authorise with this shared secret; everyone else must sign
# `polaris-verify:<taskId>` as the task's assigned agent or its requester.
# Required in production: without it the swarm cannot settle (the Circle swarm has
# no way to sign at all).
INTERNAL_API_SECRET=
# Per-IP ceilings per minute (internal callers are exempt).
# RATE_LIMIT_VERIFY=10
# RATE_LIMIT_DELIVERABLE=20
# RATE_LIMIT_ADMIN=10

# ── LLM ──────────────────────────────────────────────────────────────────────
# The default model is text-only. Image deliverables need a vision-capable model;
# without one they are reported as UNGRADEABLE and are NOT paid, because releasing
# escrow for work nobody looked at is worse than a stalled task.
# OPENROUTER_VISION_MODEL=

# ── Storage ──────────────────────────────────────────────────────────────────
# Off-chain stores live on the Railway volume at /data when it is mounted. Locally
# they go to .state/ (outside the build context, so a live SQLite file can never be
# swept into a deploy upload and truncate it).
# POLARIS_STATE_DIR=/abs/path
# INDEX_DB=/abs/path/polaris-index.db     # override the SQLite index location
# DELIVERABLE_RETENTION_DAYS=90           # blobs age out; the on-chain hash does not
# DELIVERABLE_MAX_ENTRIES=5000

# Public base URL, written on-chain as the ERC-8004 agentURI for agents this runtime
# registers, so it must be a real address for this deployment.
# PUBLIC_APP_URL=https://polarisswarm.xyz

# ── Indexing resilience ──────────────────────────────────────────────────────
# A public RPC throttles a cold backfill, so the scanner paces itself and retries
# rate limits with backoff instead of abandoning the chunk (a chunk it abandons is a
# checkpoint that never advances, which is how a production index ends up empty).
# INDEX_CHUNK_DELAY_MS=120                       # wait between getLogs chunks
# INDEX_RATE_LIMIT_BACKOFF_MS=1000,2500,6000,12000   # per successive refusal

# ── Never letting a task get stuck ───────────────────────────────────────────
# A task that cannot make progress must still reach a terminal state. Two guards:
#
# The agent's retry budget for producing + submitting a deliverable. Without a ceiling a
# permanently-failing task was retried every tick forever, paying for a model call each pass
# while pinned in ASSIGNED. Spent budget hands the task to the reaper.
# FULFIL_MAX_ATTEMPTS=3
#
# The deadline reaper. `slashOnTimeout` is permissionless, so the verdict signer can call it:
# it refunds the requester and slashes the agent that missed the deadline. The grace period
# exists because block timestamps and our clock are different clocks, and the contract
# requires block.timestamp > deadline strictly.
# REAPER_POLL_MS=120000
# REAPER_GRACE_MS=60000
#
# Deadlines before this instant are NOT enforced. Enforcement was missing for the whole life
# of the deployment, so switching it on finds a backlog, and `slashOnTimeout` refunds and
# slashes atomically: clearing 114 stale tasks on Arc would have slashed four agents 114 times
# between them and taken three below the bid floor, for failures caused by the missing reaper
# itself. Defaults to process start. Set to 0 to enforce the backlog too, deliberately.
# REAPER_ENFORCE_FROM_MS=0
